# Gemini API Key (Required for AI features)
# Spring Profile (dev, prod, test)
SPRING_PROFILE=dev

# Database Configuration
DB_URL=jdbc:mysql://localhost:3306/english_db
DB_USERNAME=root
DB_PASSWORD=your_database_password

# JWT Configuration
JWT_SECRET=YourVerySecureSecretKeyThatShouldBeAtLeast256BitsLongForHS256AlgorithmInProduction
JWT_EXPIRATION=86400000

# CORS Configuration (comma-separated list)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200,https://yourdomain.com

GOOGLE_GEMINI_API_KEY=secrect
# JPA Configuration
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true

# Server Configuration (optional)
SERVER_PORT=8080
